---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE, MONETIZATION, ANALYTICS, CATEGORIES } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const year = new Date().getFullYear();
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {MONETIZATION.adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${MONETIZATION.adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
    {ANALYTICS.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4Id}`}></script>
        <script is:inline define:vars={{ id: ANALYTICS.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body class="swiss-noise">
    <a class="skip" href="#main">Skip to content</a>
    <div class="frame">
      <header class="site-header">
        <div class="header-inner">
          <a class="logo" href="/">
            <span class="logo-mark"><Icon name="cube" /></span>
            <span>{SITE.name}</span>
          </a>
          <nav class="site-nav" aria-label="Main">
            {Object.entries(CATEGORIES).map(([key, c]) => {
              const href = `/category/${key}/`;
              const text = c.title.split(' ')[0];
              return (
                <a href={href} aria-current={path === href ? 'page' : undefined}>
                  <span class="slide"><span>{text}</span><span aria-hidden="true">{text}</span></span>
                </a>
              );
            })}
          </nav>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-mark" aria-hidden="true">
          <span>SketchUp</span><span>Warehouse</span>
        </div>
        <div class="footer-cols">
          <div class="about">
            <p class="label"><b>&copy;</b> {year} {SITE.name}</p>
            <p>Independent site, not affiliated with or endorsed by Trimble Inc. SketchUp is a trademark of Trimble Inc.</p>
          </div>
          <nav aria-label="Topics">
            <p class="label">Topics</p>
            <ul>
              {Object.entries(CATEGORIES).map(([key, c]) => <li><a href={`/category/${key}/`}>{c.title}</a></li>)}
            </ul>
          </nav>
          <nav aria-label="Footer">
            <p class="label">Site</p>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/disclosure/">Affiliate disclosure</a></li>
              <li><a href="/rss.xml">RSS</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-base">
          <span>{SITE.tagline}</span>
          <span>Est. {year}</span>
        </div>
      </footer>
    </div>

    {MONETIZATION.adsenseClient && !MONETIZATION.adPreview && (
      <script is:inline>
        // Each push fills the next unfilled unit in page order, so first drop the
        // zones hidden at this width (e.g. the sidebar on phones), then request
        // one ad per remaining zone.
        var units = [].slice.call(document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])'));
        units.forEach(function (ins) {
          if (ins.offsetWidth === 0) ins.closest('.ad').remove();
        });
        units.forEach(function (ins) {
          if (ins.isConnected) (window.adsbygoogle = window.adsbygoogle || []).push({});
        });
      </script>
    )}
    {ANALYTICS.cloudflareToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: ANALYTICS.cloudflareToken })}
      ></script>
    )}
  </body>
</html>
