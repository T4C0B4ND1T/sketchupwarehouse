---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import AdZone from '../components/AdZone.astro';
import Newsletter from '../components/Newsletter.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { getPublishedPosts, getPublishedComponents, getPublishedShowcase, getFeed, postUrl, formatDate } from '../lib/posts';
import { SITE, CATEGORIES } from '../site.config';

const posts = await getPublishedPosts();
// Main feed: articles and community showcase picks, newest first.
const feed = await getFeed();
const latest = feed.slice(0, SITE.postsPerPage);
const topics = Object.entries(CATEGORIES);
// Hero mosaic: the newest articles that have a cover photo (up to 3).
const featured = posts.filter((p) => p.data.cover).slice(0, 3);
const [components, showcase] = await Promise.all([getPublishedComponents(), getPublishedShowcase()]);
const latestNews = posts.find((p) => p.data.category === 'news');
const tutorialCount = posts.filter((p) => p.data.category === 'tutorials').length;
// Shortcuts strip under the hero: the parts of the site the header nav doesn't reach.
const shortcuts = [
  components.length > 0 && { href: '/components/', label: 'Free downloads', text: `${components.length} ready-to-use .skp components` },
  latestNews && { href: postUrl(latestNews), label: `Latest news · ${formatDate(latestNews.data.pubDate)}`, text: latestNews.data.title },
  showcase.length > 0 && { href: '/showcase/', label: 'Community', text: `${showcase.length} 3D Warehouse showcase picks` },
  tutorialCount > 0 && { href: '/category/tutorials/', label: 'Start here', text: `${tutorialCount} step-by-step tutorials` },
].filter(Boolean) as { href: string; label: string; text: string }[];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: Astro.site?.toString(),
  description: SITE.description,
};
---
<Base jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="label"><b>00.</b> {SITE.tagline}</p>
      <h1 id="hero-title" class="display">Model faster. Render better. Ship <em>the project.</em></h1>
      <p class="lede">{SITE.description}</p>
      <div class="hero-actions">
        <a class="btn" href="#latest">Latest articles <Icon name="arrow" class="icon" /></a>
        <a class="btn btn--secondary" href="/showcase/">Community showcase</a>
        <a class="btn btn--secondary" href="#topics">Browse topics</a>
      </div>
    </div>
    {featured.length > 0 ? (
      <div class="mosaic">
        {featured.map((post, i) => (
          <a class="tile" href={postUrl(post)}>
            <Image
              src={post.data.cover!.src}
              inferSize={typeof post.data.cover!.src === 'string'}
              alt=""
              widths={i === 0 ? [480, 720, 960] : [360, 480]}
              sizes={i === 0 ? '(min-width: 1024px) 480px, 100vw' : '(min-width: 1024px) 240px, 50vw'}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <span class="tile-label">
              <span class="label"><b>{String(i + 1).padStart(2, '0')}.</b> {CATEGORIES[post.data.category].title}</span>
              <span class="tile-title">{post.data.title}</span>
            </span>
          </a>
        ))}
        {featured.length < 3 && (
          <div class="tile tile--art composition swiss-grid-pattern" aria-hidden="true" style={`--rest: ${3 - featured.length}`}>
            <div class="c-post"></div>
            <div class="c-circle"></div>
            <div class="c-square swiss-dots"></div>
            <div class="c-block"></div>
            <div class="c-bar"></div>
          </div>
        )}
      </div>
    ) : (
      <div class="composition swiss-grid-pattern" aria-hidden="true">
        <div class="c-post"></div>
        <div class="c-circle"></div>
        <div class="c-square swiss-dots"></div>
        <div class="c-block"></div>
        <div class="c-bar"></div>
        <div class="c-caption">Fig. 01 — Push / Pull</div>
      </div>
    )}
  </section>

  {shortcuts.length > 0 && (
    <nav class="shortcuts" aria-label="Shortcuts">
      {shortcuts.map((s) => (
        <a class="shortcut" href={s.href}>
          <span class="label">{s.label}</span>
          <strong>{s.text}</strong>
          <Icon name="arrow" class="icon" />
        </a>
      ))}
    </nav>
  )}

  <AdZone zone="pageTop" />

  <Section index="01" label="Journal" title="Latest articles" id="latest">
    <p slot="intro">New tutorials, reviews and release notes — researched, cited and updated when SketchUp changes.</p>
    <div class="grid">
      {latest.map((entry, i) => (
        <>
          {entry.kind === 'post'
            ? <PostCard post={entry.post} index={i + 1} />
            : <ShowcaseCard item={entry.item} index={i + 1} />}
          {i === 5 && latest.length > 6 && <AdZone zone="feed" />}
        </>
      ))}
    </div>
    {feed.length > SITE.postsPerPage && (
      <nav class="pager pager--single" aria-label="Pagination">
        <a href="/blog/2/">Older articles <Icon name="arrow" class="icon" /></a>
      </nav>
    )}
  </Section>

  <AdZone zone="sectionBreak" />

  <Section index="02" label="Index" title="Browse by topic" id="topics">
    <p slot="intro">Six disciplines, one tool. Pick the part of your workflow you want to improve.</p>
    <div class="grid">
      {topics.map(([key, c], i) => (
        <article class="card card--topic">
          <div class="card-top">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <Icon name="plus" class="plus" />
          </div>
          <h3><a href={`/category/${key}/`}>{c.title}</a></h3>
          <p>{c.description}</p>
        </article>
      ))}
    </div>
  </Section>

  <Newsletter />
</Base>
