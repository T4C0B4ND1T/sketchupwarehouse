---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE, CATEGORIES } from '../site.config';

const posts = await getPublishedPosts();
const latest = posts.slice(0, SITE.postsPerPage);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: Astro.site?.toString(),
  description: SITE.description,
};
---
<Base jsonLd={jsonLd}>
  <section class="hero">
    <h1>Model faster. Render better. Ship the project.</h1>
    <p>{SITE.description}</p>
  </section>

  <h2 class="section-title">Latest articles</h2>
  <div class="grid">
    {latest.map((post) => <PostCard post={post} />)}
  </div>
  {posts.length > SITE.postsPerPage && (
    <div class="pager"><span></span><a class="btn" href="/blog/2/">Older articles →</a></div>
  )}

  <AdSlot slot="footer" />

  <h2 class="section-title" style="margin-top:48px">Browse by topic</h2>
  <div class="grid">
    {Object.entries(CATEGORIES).map(([key, c]) => (
      <article class="card">
        <h3><a href={`/category/${key}/`}>{c.title}</a></h3>
        <p>{c.description}</p>
      </article>
    ))}
  </div>

  <Newsletter />
</Base>
