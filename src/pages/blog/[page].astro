---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';
import { SITE } from '../../site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Post> };
const offset = (page.currentPage - 1) * SITE.postsPerPage;
---
<Base title={`All articles — page ${page.currentPage}`} noindex={page.currentPage > 1}>
  <section class="page-hero swiss-grid-pattern bg-muted">
    <p class="label"><b>{String(page.currentPage).padStart(2, '0')}.</b> Page {page.currentPage} of {page.lastPage}</p>
    <h1>All articles</h1>
  </section>
  <div class="grid grid--3">{page.data.map((post, i) => <PostCard post={post} index={offset + i + 1} />)}</div>
  <nav class="pager" aria-label="Pagination">
    {page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span></span>}
    {page.url.next ? <a href={page.url.next}>Older <Icon name="arrow" class="icon" /></a> : <span></span>}
  </nav>
</Base>
