---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';
import { SITE } from '../../site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Post> };
---
<Base title={`All articles — page ${page.currentPage}`} noindex={page.currentPage > 1}>
  <h1 class="section-title">All articles · page {page.currentPage} of {page.lastPage}</h1>
  <div class="grid">{page.data.map((post) => <PostCard post={post} />)}</div>
  <nav class="pager" aria-label="Pagination">
    {page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span></span>}
    {page.url.next ? <a href={page.url.next}>Older →</a> : <span></span>}
  </nav>
</Base>
