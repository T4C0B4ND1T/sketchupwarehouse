---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import AdZone from '../../components/AdZone.astro';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import Avatar from '../../components/Avatar.astro';
import { getAuthor, authorUrl } from '../../lib/authors';
import { getPublishedPosts, formatDate, readingTime, relatedPosts, postUrl, type Post } from '../../lib/posts';
import { SITE, CATEGORIES } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props { post: Post; all: Post[] }
const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
const cat = CATEGORIES[data.category];
const author = getAuthor(data.author);
const related = relatedPosts(post, all);
// Newest posts in the same topic that "Related reading" didn't already show.
const shown = new Set([post.id, ...related.map((p) => p.id)]);
const moreInTopic = all.filter((p) => p.data.category === data.category && !shown.has(p.id)).slice(0, 5);
const topicCount = all.filter((p) => p.data.category === data.category).length;
const toc = headings.filter((h) => h.depth === 2);
const url = new URL(Astro.url.pathname, Astro.site).toString();
// Social preview: the cover cropped to the standard 1200×630 share size.
const ogImage = data.cover
  ? (await getImage({ src: data.cover.src, inferSize: typeof data.cover.src === 'string', width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: data.title,
      ...(ogImage ? { image: new URL(ogImage, Astro.site).toString() } : {}),
      description: data.description,
      datePublished: data.pubDate.toISOString(),
      dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
      author: { '@type': 'Person', name: author.name, url: new URL(authorUrl(author), Astro.site).toString() },
      publisher: { '@type': 'Organization', name: SITE.name },
      mainEntityOfPage: url,
      keywords: data.tags.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
        { '@type': 'ListItem', position: 2, name: cat.title, item: new URL(`/category/${data.category}/`, Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: data.title, item: url },
      ],
    },
  ],
};
---
<Base title={data.title} description={data.description} type="article" jsonLd={jsonLd} image={ogImage}>
  <article class="article">
    <header class="article-head">
      <a class="label" href={`/category/${data.category}/`}><b>→</b> {cat.title}</a>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <a class="byline" href={authorUrl(author)} rel="author"><Avatar author={author} /><span>By {author.name}</span></a>
      <div class="meta">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        {data.updatedDate && <span>Updated {formatDate(data.updatedDate)}</span>}
        <span>{readingTime(post.body)} min read</span>
      </div>
    </header>

    {data.cover && (
      <figure class="article-cover">
        <Image
          src={data.cover.src}
          inferSize={typeof data.cover.src === 'string'}
          alt={data.cover.alt}
          widths={[640, 960, 1440]}
          sizes="(min-width: 1440px) 1432px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        {data.cover.credit && (
          <figcaption>
            Photo: {data.cover.creditUrl
              ? <a href={data.cover.creditUrl} rel="noopener">{data.cover.credit}{data.cover.pexelsId && ' / Pexels'}</a>
              : data.cover.credit}
          </figcaption>
        )}
      </figure>
    )}

    <AdZone zone="pageTop" />

    <div class="article-layout">
      <div class="article-body">
        <div class="prose">
          <Content />
        </div>

        {(data.sources.length > 0 || data.aiAssisted) && (
          <footer class="endnotes">
            {data.sources.length > 0 && (
              <section class="sources" aria-labelledby="sources-title">
                <h2 id="sources-title" class="label"><b>§</b> Sources</h2>
                <ol>
                  {data.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
                </ol>
              </section>
            )}
            {data.aiAssisted && (
              <p class="ai-note">
                This article was drafted with AI assistance from the sources listed above and published under our
                <a href="/about/#editorial-standards">editorial standards</a>.{author.penName && <> {author.name} is one of our <a href="/authors/">house pen names</a>.</>} Spot an error? <a href="/contact/">Tell us</a> and we'll fix it.
              </p>
            )}
          </footer>
        )}

        {moreInTopic.length > 0 && (
          <nav class="more-topic" aria-labelledby="more-title">
            <p class="label" id="more-title">More in {cat.title}</p>
            <ul>{moreInTopic.map((p) => <li><a href={postUrl(p)}>{p.data.title}</a></li>)}</ul>
            <a class="hub-link" href={`/category/${data.category}/`}>All {topicCount} {cat.title} articles <Icon name="arrow" class="icon" /></a>
          </nav>
        )}

        <AdZone zone="articleEnd" />
      </div>

      <aside class="article-aside swiss-grid-pattern bg-muted" aria-label="Article details">
        <AdZone zone="sidebar" />
        <div class="sticky">
          {toc.length > 0 && (
            <nav class="toc" aria-labelledby="toc-title">
              <p class="label" id="toc-title">In this article</p>
              <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </nav>
          )}
          {data.tags.length > 0 && (
            <div>
              <p class="label">Tags</p>
              <div class="tags">{data.tags.map((t) => <span>{t}</span>)}</div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </article>

  <template id="ad-in-article"><AdZone zone="inArticle" /></template>
  <script is:inline>
    // Fill the in-article markers (placed at section breaks at build time).
    (function () {
      var tpl = document.getElementById('ad-in-article');
      document.querySelectorAll('.ad-marker').forEach(function (m) {
        if (tpl && tpl.content.childElementCount) m.replaceWith(tpl.content.cloneNode(true));
      });
    })();
  </script>

  {related.length > 0 && (
    <Section index="→" label="Continue" title="Related reading" id="related">
      <div class="grid">{related.map((p, i) => <PostCard post={p} index={i + 1} />)}</div>
    </Section>
  )}

  <Newsletter />
</Base>
