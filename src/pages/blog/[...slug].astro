---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getPublishedPosts, formatDate, readingTime, relatedPosts, type Post } from '../../lib/posts';
import { SITE, CATEGORIES } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props { post: Post; all: Post[] }
const { post, all } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const cat = CATEGORIES[data.category];
const related = relatedPosts(post, all);
const url = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: data.title,
      description: data.description,
      datePublished: data.pubDate.toISOString(),
      dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
      author: { '@type': 'Organization', name: SITE.author },
      publisher: { '@type': 'Organization', name: SITE.name },
      mainEntityOfPage: url,
      keywords: data.tags.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
        { '@type': 'ListItem', position: 2, name: cat.title, item: new URL(`/category/${data.category}/`, Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: data.title, item: url },
      ],
    },
  ],
};
---
<Base title={data.title} description={data.description} type="article" jsonLd={jsonLd}>
  <article class="article">
    <header>
      <a class="card-cat" href={`/category/${data.category}/`}>{cat.title}</a>
      <h1>{data.title}</h1>
      <div class="meta">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        {data.updatedDate && <span>Updated {formatDate(data.updatedDate)}</span>}
        <span>{readingTime(post.body)} min read</span>
      </div>
    </header>

    <AdSlot slot="inArticle" format="fluid" />

    <div class="prose">
      <Content />
    </div>

    {data.tags.length > 0 && (
      <div class="tags">{data.tags.map((t) => <span>{t}</span>)}</div>
    )}

    {data.sources.length > 0 && (
      <section class="sources">
        <strong>Sources</strong>
        <ol>
          {data.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
        </ol>
      </section>
    )}

    {data.aiAssisted && (
      <p class="ai-note">
        This article was drafted with AI assistance from the sources listed above and published under our
        <a href="/about/#editorial-standards">editorial standards</a>. Spot an error? <a href="/contact/">Tell us</a> and we'll fix it.
      </p>
    )}

    <AdSlot slot="footer" />
  </article>

  {related.length > 0 && (
    <section class="related article">
      <h2 class="section-title">Related reading</h2>
      <div class="grid">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  <Newsletter />
</Base>
