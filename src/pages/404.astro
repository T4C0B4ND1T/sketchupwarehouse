---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="page-hero not-found swiss-grid-pattern bg-muted">
    <p class="label"><b>Error.</b> Page not found</p>
    <p class="display" aria-hidden="true">404</p>
    <h1>This page doesn't exist (anymore)</h1>
  </section>
  <div class="page-body">
    <div class="prose">
      <p>Try the <a href="/">homepage</a> or browse the latest articles.</p>
      <p>Looking for free SketchUp models? They live on the official <a href="https://3dwarehouse.sketchup.com/">3D Warehouse</a>.</p>
    </div>
  </div>
</Base>
