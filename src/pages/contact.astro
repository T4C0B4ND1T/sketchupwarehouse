---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---
<Base title="Contact" description={`Contact ${SITE.name}.`}>
  <section class="page-hero swiss-grid-pattern bg-muted">
    <p class="label"><b>§</b> Correspondence</p>
    <h1>Contact</h1>
  </section>
  <div class="page-body">
    <div class="prose">
      <p>Corrections, tips, partnership and advertising enquiries: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
      <p>Extension developers: we're happy to look at your plugin for a review. Send a link and a short description.</p>
    </div>
  </div>
</Base>
