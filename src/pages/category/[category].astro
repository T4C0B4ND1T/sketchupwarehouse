---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getPublishedPosts } from '../../lib/posts';
import { CATEGORIES, CATEGORY_KEYS, type CategoryKey } from '../../site.config';

export function getStaticPaths() {
  return CATEGORY_KEYS.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as CategoryKey;
const info = CATEGORIES[category];
const number = String(CATEGORY_KEYS.indexOf(category) + 1).padStart(2, '0');
const posts = (await getPublishedPosts()).filter((p) => p.data.category === category);
---
<Base title={`SketchUp ${info.title}`} description={info.description}>
  <section class="page-hero swiss-grid-pattern bg-muted">
    <p class="label"><b>{number}.</b> Topic · {posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
    <h1>{info.title}</h1>
    <p>{info.description}</p>
  </section>
  {posts.length > 0
    ? <div class="grid grid--3 rule-b">{posts.map((post, i) => <PostCard post={post} index={i + 1} />)}</div>
    : <p class="empty rule-b">New articles in this section are on the way.</p>}
  <AdSlot slot="footer" />
</Base>
