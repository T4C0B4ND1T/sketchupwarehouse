---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import AdZone from '../../components/AdZone.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedPosts, postUrl } from '../../lib/posts';
import { CATEGORIES, CATEGORY_KEYS, type CategoryKey } from '../../site.config';

export function getStaticPaths() {
  return CATEGORY_KEYS.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as CategoryKey;
const info = CATEGORIES[category];
const number = String(CATEGORY_KEYS.indexOf(category) + 1).padStart(2, '0');
const all = await getPublishedPosts();
const posts = all.filter((p) => p.data.category === category);
const otherTopics = CATEGORY_KEYS.filter((k) => k !== category).map((key) => ({
  key,
  ...CATEGORIES[key],
  count: all.filter((p) => p.data.category === key).length,
}));
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `SketchUp ${info.title}`,
      description: info.description,
      url,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: new URL(postUrl(p), Astro.site).toString(),
          name: p.data.title,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
        { '@type': 'ListItem', position: 2, name: info.title, item: url },
      ],
    },
  ],
};
---
<Base title={`SketchUp ${info.title}`} description={info.description} jsonLd={jsonLd} noindex={posts.length === 0}>
  <section class="page-hero swiss-grid-pattern bg-muted">
    <p class="label"><b>{number}.</b> Topic · {posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
    <h1>{info.title}</h1>
    <p>{info.description}</p>
  </section>
  <AdZone zone="pageTop" />
  {posts.length > 0
    ? <div class="grid grid--3 rule-b">{posts.map((post, i) => (
        <>
          <PostCard post={post} index={i + 1} />
          {i === 5 && posts.length > 6 && <AdZone zone="feed" />}
        </>
      ))}</div>
    : <p class="empty rule-b">New articles in this section are on the way.</p>}

  <Section index="→" label="Index" title="Other topics" id="topics">
    <div class="grid">
      {otherTopics.map((t) => (
        <article class="card card--topic">
          <div class="card-top">
            <span class="num" aria-hidden="true">{String(CATEGORY_KEYS.indexOf(t.key) + 1).padStart(2, '0')}</span>
            <Icon name="plus" class="plus" />
          </div>
          <h3><a href={`/category/${t.key}/`}>{t.title}</a></h3>
          <p>{t.description}</p>
          {t.count > 0 && <p class="label">{t.count} {t.count === 1 ? 'article' : 'articles'}</p>}
        </article>
      ))}
    </div>
  </Section>
</Base>
