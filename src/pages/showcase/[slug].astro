---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdZone from '../../components/AdZone.astro';
import ShowcaseCard from '../../components/ShowcaseCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedShowcase, formatDate, type ShowcaseItem } from '../../lib/posts';

export async function getStaticPaths() {
  const items = await getPublishedShowcase();
  return items.map((item) => ({ params: { slug: item.id }, props: { item, all: items } }));
}

interface Props { item: ShowcaseItem; all: ShowcaseItem[] }
const { item, all } = Astro.props;
const { Content } = await render(item);
const { data } = item;
const more = all.filter((c) => c.id !== item.id).slice(0, 3);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const embedUrl = `https://3dwarehouse.sketchup.com/embed/${data.warehouseId}`;
const count = new Intl.NumberFormat('en-US');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': '3DModel',
      name: data.title,
      description: data.description,
      image: data.thumbnail.src,
      url: data.warehouseUrl,
      creator: { '@type': 'Person', name: data.creator.name, url: data.creator.url },
      keywords: data.tags.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
        { '@type': 'ListItem', position: 2, name: 'Showcase', item: new URL('/showcase/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: data.title, item: url },
      ],
    },
  ],
};
---
<Base title={`${data.title} by ${data.creator.name}`} description={data.description} jsonLd={jsonLd} image={data.thumbnail.src}>
  <article class="article">
    <header class="article-head">
      <a class="label" href="/showcase/"><b>→</b> Showcase</a>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <div class="meta">
        <span>Model by <a href={data.creator.url} rel="noopener">{data.creator.name}</a></span>
        <span>On 3D Warehouse</span>
        <time datetime={data.pubDate.toISOString()}>Picked {formatDate(data.pubDate)}</time>
      </div>
    </header>

    <div class="model-preview model-preview--embed swiss-grid-pattern bg-muted">
      <iframe src={embedUrl} title={`3D view of ${data.title} by ${data.creator.name}, from 3D Warehouse`} loading="lazy" allowfullscreen></iframe>
    </div>

    <div class="model-actions">
      <a class="btn" href={data.warehouseUrl} rel="noopener">Download on 3D Warehouse <Icon name="arrow" class="icon" /></a>
      <a class="btn btn--secondary" href={data.creator.url} rel="noopener">More by {data.creator.name}</a>
    </div>

    <AdZone zone="pageTop" />

    <div class="article-layout">
      <div class="article-body">
        <div class="prose">
          <Content />
        </div>
        <p class="ai-note">
          This model was made by <a href={data.creator.url} rel="noopener">{data.creator.name}</a> and is shared on
          <a href={data.warehouseUrl} rel="noopener">3D Warehouse</a>, where you can download it under 3D Warehouse's terms.
          We don't host the file; the 3D view and thumbnail load from 3D Warehouse. If this is your model and you'd like
          it changed or removed, <a href="/contact/">tell us</a>.
        </p>
        <AdZone zone="articleEnd" />
      </div>
      <aside class="article-aside swiss-grid-pattern bg-muted" aria-label="Model details">
        <AdZone zone="sidebar" />
        <div class="sticky">
          <div>
            <p class="label">Creator</p>
            <p><a href={data.creator.url} rel="noopener">{data.creator.name}</a></p>
          </div>
          {data.stats && (
            <div>
              <p class="label">On 3D Warehouse</p>
              <p>{count.format(data.stats.downloads)} downloads<br />{count.format(data.stats.views)} views<br /><small>as of {formatDate(data.stats.asOf)}</small></p>
            </div>
          )}
          {data.tags.length > 0 && (
            <div>
              <p class="label">Tags</p>
              <div class="tags">{data.tags.map((t) => <span>{t}</span>)}</div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </article>

  {more.length > 0 && (
    <Section index="→" label="Community" title="More from the showcase" id="more">
      <div class="grid">{more.map((c, i) => <ShowcaseCard item={c} index={i + 1} />)}</div>
    </Section>
  )}

  <Newsletter />
</Base>
