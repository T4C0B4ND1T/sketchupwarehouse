---
import Base from '../../layouts/Base.astro';
import AdZone from '../../components/AdZone.astro';
import ShowcaseCard from '../../components/ShowcaseCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getPublishedShowcase, showcaseUrl } from '../../lib/posts';

const items = await getPublishedShowcase();
const title = 'Community Showcase: Popular SketchUp Models';
const description = 'Popular SketchUp models from creators on 3D Warehouse, picked by us. Every model is credited to its creator and downloads from 3D Warehouse.';
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: title,
      description,
      url,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: items.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: new URL(showcaseUrl(c), Astro.site).toString(),
          name: c.data.title,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
        { '@type': 'ListItem', position: 2, name: 'Showcase', item: url },
      ],
    },
  ],
};
---
<Base title={title} description={description} jsonLd={jsonLd} noindex={items.length === 0}>
  <section class="page-hero swiss-grid-pattern bg-muted">
    <p class="label"><b>→</b> Community · {items.length} {items.length === 1 ? 'model' : 'models'}</p>
    <h1>Showcase</h1>
    <p>{description}</p>
  </section>
  <AdZone zone="pageTop" />
  {items.length > 0
    ? <div class="grid grid--3 rule-b">{items.map((item, i) => (
        <>
          <ShowcaseCard item={item} index={i + 1} />
          {i === 5 && items.length > 6 && <AdZone zone="feed" />}
        </>
      ))}</div>
    : <p class="empty rule-b">New picks are on the way.</p>}
  <Newsletter />
</Base>
